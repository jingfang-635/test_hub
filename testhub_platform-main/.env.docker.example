# TestHub Docker 部署环境变量
# 复制为 .env 后修改密码与密钥：
#   copy .env.docker.example .env        (Windows)
#   cp .env.docker.example .env          (Linux/Mac)

# ========== 对外端口 ==========
FRONTEND_PORT=80

# ========== Django ==========
SECRET_KEY=please-change-this-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# ========== 数据库（MySQL 容器会自动创建库） ==========
DB_NAME=testhub
DB_USER=root
DB_PASSWORD=TestHub@2024
DB_PORT=3306

# ========== Redis（compose 内会自动指向 redis 服务，此处可留默认） ==========
REDIS_URL=redis://redis:6379/0

# ========== 首次启动自动创建管理员（可选） ==========
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@testhub.local
DJANGO_SUPERUSER_PASSWORD=Admin@123456

# ========== 构建选项 ==========
# true = 安装 UI/APP/AI 等可选依赖（镜像更大、构建更慢）
INSTALL_OPTIONAL=false

# ========== 本地化 ==========
LANGUAGE_CODE=zh-hans
TIME_ZONE=Asia/Shanghai

# ========== 邮件（可选） ==========
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=465
# EMAIL_USE_TLS=False
# EMAIL_USE_SSL=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=
