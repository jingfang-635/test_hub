# 忽略虚拟环境及项目产生的临时文件
.venv/
venv/
venv*/
.idea/
.claude/
.vscode/
.trae/
__pycache__/
.DS_Store
.pytest_cache
# 忽略 allure 命令行工具二进制（部署时单独安装）
allure/
# 忽略 Playwright 浏览器二进制（运行时自动下载）
ms-playwright/
备注笔记.txt
# 忽略运行时日志
*.log
debug.log
# 忽略log文件，但保留.gitkeep和子目录
logs/*
!logs/.gitkeep
!logs/*/
logs/*/*
!logs/*/.gitkeep
# 忽略.env配置文件(但保留.env.example示例文件)
.env
.sql
static_files/img/
.bak
# 忽略所有 app/*/migrations/ 目录下的所有内容 (包括文件和子目录)
# 但保留迁移文件 (*.py) 以便 Vercel 部署时能正确执行迁移
apps/*/migrations/*
# 使用否定模式，例外地跟踪 __init__.py 和迁移文件
!apps/*/migrations/__init__.py
!apps/*/migrations/0*.py

# 重构后 apps 迁移至 backend/apps，同样规则需覆盖新路径
backend/apps/*/migrations/*
!backend/apps/*/migrations/__init__.py
!backend/apps/*/migrations/0*.py

# 忽略 allure-static 下的所有文件（运行时生成）
media/allure-static/*
!media/allure-static/.gitkeep

# 忽略 AI 录屏文件，但保留.gitkeep
media/ai_recording/*
!media/ai_recording/.gitkeep

# 忽略需求文档上传的文件，但保留.gitkeep
media/requirement_docs/*
!media/requirement_docs/.gitkeep

# 忽略接口测试运行时产生的 Allure 报告文件，但保留.gitkeep文件
media/api-testing/allure-results/*
!media/api-testing/allure-results/.gitkeep
media/api-testing/allure-reports/*
!media/api-testing/allure-reports/.gitkeep
media/api-testing/allure-static/*
!media/api-testing/allure-static/.gitkeep

# 忽略 APP 自动化运行时产生的文件，但保留.gitkeep文件
media/app-automation/allure-results/*
!media/app-automation/allure-results/.gitkeep
media/app-automation/allure-reports/*
!media/app-automation/allure-reports/.gitkeep
media/app-automation/screenshots/*
!media/app-automation/screenshots/.gitkeep

# 忽略APP自动化模板文件
apps/app_automation/Template/**
!apps/app_automation/Template/

# 忽略前端文件
frontend/node_modules/
frontend/.DS_Store
frontend/*.log
frontend/dist/
# frontend_dist/  # 不再忽略，需要提交到仓库供 Vercel 使用

# Docker 本地覆盖（保留仓库内 docker-compose / Dockerfile）
docker-compose.override.yml

# ========== 重构升级新增排除项 ==========
# 忽略统一配置文件（含真实密钥，请勿提交；使用 config.yaml.example 作为模板）
config.yaml
# 忽略 AI 探索截图运行时文件，但保留 .gitkeep
media/exploration_screenshots/*
!media/exploration_screenshots/.gitkeep
# 忽略 UI 自动化项目登录态（cookies/storage_state）
media/ui-automation/auth/*
!media/ui-automation/auth/.gitkeep
# 忽略知识库文档上传文件，但保留 .gitkeep
media/knowledge_docs/*
!media/knowledge_docs/.gitkeep
# 忽略 AI 录屏二进制文件
backend/agent_history.gif
# 忽略临时测试脚本
backend/_run_delete_test.py