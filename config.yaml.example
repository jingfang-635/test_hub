# ============================================
# TestHub 统一配置文件（示例模板）
# 复制本文件为 config.yaml 并填入真实值后使用：
#   cp config.yaml.example config.yaml
# 本地开发环境在 config.yaml 中统一配置；生产/Vercel 环境用环境变量覆盖
# 优先级：环境变量 > config.yaml > 默认值
# 注意：config.yaml 含敏感信息，已在 .gitignore 中排除，请勿提交
# ============================================

# ========== 服务配置 ==========
FRONTEND_PORT: 3000
BACKEND_PORT: 8000
DEBUG: true
SECRET_KEY: django-insecure-please-change-me-to-a-random-string
ALLOWED_HOSTS: "*"
CORS_ALLOWED_ORIGINS: http://localhost:3000,http://127.0.0.1:3000

# ========== 数据库配置 ==========
DB_NAME: testhub
DB_USER: your_db_user
DB_PASSWORD: your_db_password
DB_HOST: 127.0.0.1
DB_PORT: 3306

# ========== Redis 配置 ==========
REDIS_URL: redis://127.0.0.1:6379/0

# ========== 邮件配置 ==========
EMAIL_HOST: smtp.qq.com
EMAIL_PORT: 465
EMAIL_USE_TLS: false
EMAIL_USE_SSL: true
EMAIL_HOST_USER: your_email@qq.com
EMAIL_HOST_PASSWORD: your_email_smtp_auth_code
DEFAULT_FROM_EMAIL: your_email@qq.com

# ========== 本地化 ==========
LANGUAGE_CODE: zh-hans
TIME_ZONE: Asia/Shanghai

# ========== 飞书开放平台（企业自建应用 + 用户 OAuth 拉取需求文档） ==========
FEISHU_APP_ID: your_feishu_app_id
FEISHU_APP_SECRET: your_feishu_app_secret
FEISHU_BASE_URL: https://open.feishu.cn
FEISHU_ACCOUNTS_URL: https://accounts.feishu.cn
# 须与飞书开发者后台「安全设置 → 重定向 URL」完全一致（推荐指到前端页，由前端调 oauth_complete 落库）
FEISHU_REDIRECT_URI: http://localhost:3000/ai-generation/requirement-analysis
# OAuth 直连后端回调成功后的前端跳转（前端中转模式下可与 REDIRECT_URI 相同）
FEISHU_FRONTEND_REDIRECT: http://localhost:3000/ai-generation/requirement-analysis
FEISHU_OAUTH_SCOPES: "offline_access docx:document:readonly wiki:wiki:readonly"

# ========== Figma（Personal Access Token，用于解析设计稿文本并生成用例） ==========
# 在 https://www.figma.com/developers/api#access-tokens 创建，需能访问目标文件
FIGMA_ACCESS_TOKEN: your_figma_personal_access_token
FIGMA_API_BASE: https://api.figma.com/v1
