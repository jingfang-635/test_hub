# ================================
# 本地开发环境变量示例
# 复制为 .env 后按需修改；也可用项目根目录 config.yaml
# ================================

# 服务端口
FRONTEND_PORT=3002
BACKEND_PORT=8000

# Django
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:3002,http://127.0.0.1:3002

# 数据库（本地 MySQL）
DB_NAME=testhub
DB_USER=root
DB_PASSWORD=your-database-password
DB_HOST=127.0.0.1
DB_PORT=3306

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# 邮件（可选，定时任务通知）
EMAIL_HOST=smtp.163.com
EMAIL_PORT=465
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_email_password
DEFAULT_FROM_EMAIL=your_email@gmail.com

# 本地化
LANGUAGE_CODE=zh-hans
TIME_ZONE=Asia/Shanghai

# Allure 报告语言（allure 内置语言代码，如 zh / en / ja / ko / fr / de）
ALLURE_REPORT_LANGUAGE=zh

# 生产注意：修改 SECRET_KEY、DEBUG=False，并限制 ALLOWED_HOSTS / CORS
